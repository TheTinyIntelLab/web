# Use the public HTTPS origin in production. Vercel can supply its production host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Search Console HTML tag verification token for the current site.
GOOGLE_SITE_VERIFICATION=
# Public Sanity project ID and dataset. A public dataset needs no API token.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
